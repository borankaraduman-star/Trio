# VPS alternative (Docker Compose + coturn). Copy to deploy/.env and fill in. Never commit .env.
# On Railway these are set in the dashboard instead (see README.md).

# Public hostname; its DNS A record must point at this server (used by Caddy for HTTPS, by coturn as realm, and as the TURN host).
TRIO_DOMAIN=chat.example.com

# Public IPv4 of the server (coturn advertises it for relayed media). Behind provider NAT use PUBLIC/PRIVATE, e.g. 203.0.113.7/10.0.0.5.
TRIO_PUBLIC_IP=203.0.113.7

# Shared secret friends type once to join. Generate: openssl rand -hex 8   (anything hard to guess works)
TRIO_INVITE_CODE=

# Secret shared by the app and coturn for time-limited TURN credentials. Generate: openssl rand -hex 32   (hex only)
TRIO_TURN_SECRET=

# Optional: joins beyond this many accounts are refused (default 10).
#TRIO_MAX_USERS=10

# Optional: comma-separated STUN URLs (default: this server's own coturn, stun:<TRIO_DOMAIN>:3478).
#TRIO_STUN_URLS=stun:stun.l.google.com:19302

# Optional: largest attachment per file in MB (default 25).
#TRIO_MAX_UPLOAD_MB=25

# Optional: Cloudflare Realtime TURN instead of the local coturn (takes precedence
# when both are set). Dashboard: Realtime -> TURN Server -> Create.
#TRIO_CF_TURN_KEY_ID=
#TRIO_CF_TURN_API_TOKEN=
