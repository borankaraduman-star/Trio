**/dist
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/*.egg-info
**/*.db
**/*.db-*
**/*.sqlite*
**/uploads
**/.env
**/.env.*
.git
.github
desktop
design
e2e
deploy
server/tests
*.md
